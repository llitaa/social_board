Options -Indexes
Header set X-Robots-Tag "noindex, nofollow, noarchive"
Header set Cache-Control "no-store"
<FilesMatch "\.(jsonl|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(api|index)\.php$">
  Require all granted
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^data/uploads/memos/ - [F]
RewriteRule ^data/decisions/ - [F]
RewriteRule ^data/decisions-local/ - [F]
</IfModule>
